<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below; backups are off anyway (allowBackup="false"). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
